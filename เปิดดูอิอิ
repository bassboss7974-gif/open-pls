<title>ลองเปิดดูอิอิ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mali:wght@600&display=swap">
<style>
  /* Layout: one full-screen canvas. The heart is drawn in a fixed virtual space and scaled uniformly to fit, so its shape and word layout never change with screen size. */
  :root {
    --bg-deep: #1b0a13;
    --bg-glow: #3b1425;
    --rose: #ff5d7e;
    --blush: #ffc9d6;
    --font-display: 'Mali', 'Sarabun', 'Noto Sans Thai', sans-serif;
    color-scheme: dark;
  }
  html, body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--bg-deep);
    color: var(--blush);
  }
  body {
    background:
      radial-gradient(60% 55% at 50% 48%, var(--bg-glow) 0%, var(--bg-deep) 100%);
    font-family: var(--font-display);
  }
  #glow {
    position: fixed;
    inset: 0;
    background: radial-gradient(38% 34% at 50% 50%, rgba(255, 93, 126, 0.22), transparent 70%);
    animation: beat 1.4s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes beat {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    10% { opacity: 1; transform: scale(1.06); }
    30% { opacity: 0.8; transform: scale(1.03); }
  }
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: pointer;
    touch-action: manipulation;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }
  html, body, #glow {
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
  }
  canvas::selection, body::selection { background: transparent; }
  @media (prefers-reduced-motion: reduce) {
    #glow { animation: none; opacity: 0.7; }
  }
</style>

<div id="glow"></div>
<canvas id="c" aria-label="รักแฟน (มิน) เรียงเป็นรูปหัวใจ" role="img"></canvas>

<script>
(function () {
  var WORD = 'รักแฟน (มิน)';
  var VW = 680;    // virtual heart width
  var VFS = 18;    // virtual font size
  var cv = document.getElementById('c');
  var ctx = cv.getContext('2d');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W, H, dpr, k;
  var shapePath, by0, by1, fontCss;
  var words = [];
  var floaters = [];
  var bursts = [];
  var started = false;

  var A = [255, 93, 126];   // rose
  var B = [255, 201, 214];  // blush

  // Fixed heart outline in virtual coordinates, centred on (0,0)
  function buildShape() {
    var q = VW / 32, pts = [], minY = 1e9, maxY = -1e9, i, t, x, y;
    for (i = 0; i < 240; i++) {
      t = i / 240 * Math.PI * 2;
      x = q * 16 * Math.pow(Math.sin(t), 3);
      y = -q * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
      pts.push([x, y]);
      if (y < minY) minY = y;
      if (y > maxY) maxY = y;
    }
    var oy = (minY + maxY) / 2;
    shapePath = new Path2D();
    for (i = 0; i < pts.length; i++) {
      if (i === 0) shapePath.moveTo(pts[i][0], pts[i][1] - oy);
      else shapePath.lineTo(pts[i][0], pts[i][1] - oy);
    }
    shapePath.closePath();
    by0 = minY - oy;
    by1 = maxY - oy;
  }

  // Fixed word grid in virtual coordinates (brick pattern), clipped to the heart when drawn
  function buildWords() {
    fontCss = '600 ' + VFS + 'px ' + getComputedStyle(document.documentElement).getPropertyValue('--font-display');
    ctx.font = fontCss;
    var ww = ctx.measureText(WORD).width;
    var stepX = ww + VFS * 0.9;
    var stepY = VFS * 1.7;
    words = [];
    var row = 0;
    for (var y = by0 - stepY; y <= by1 + stepY; y += stepY, row++) {
      var off = (row % 2) * stepX / 2;
      for (var x = -VW / 2 - stepX + off; x <= VW / 2 + stepX; x += stepX) {
        words.push({ x: x, y: y, ph: (x + y) / VW * 2.5 });
      }
    }
  }

  function layout() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.clientWidth;
    H = cv.clientHeight;
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    var heartH = by1 - by0;
    k = Math.min(W * 0.9 / VW, H * 0.9 / heartH);

    if (!floaters.length) {
      for (var n = 0; n < 12; n++) {
        floaters.push({
          x: Math.random(), y: Math.random(),
          s: 5 + Math.random() * 8,
          v: 0.012 + Math.random() * 0.02,
          d: Math.random() * 6.28,
          a: 0.1 + Math.random() * 0.16
        });
      }
    }
    draw(performance.now() / 1000);
  }

  function heartPath(s) {
    ctx.beginPath();
    ctx.moveTo(0, s * 0.9);
    ctx.bezierCurveTo(-s * 1.4, s * 0.1, -s * 0.7, -s * 0.9, 0, -s * 0.3);
    ctx.bezierCurveTo(s * 0.7, -s * 0.9, s * 1.4, s * 0.1, 0, s * 0.9);
    ctx.closePath();
  }

  function mix(m) {
    return [
      Math.round(A[0] + (B[0] - A[0]) * m),
      Math.round(A[1] + (B[1] - A[1]) * m),
      Math.round(A[2] + (B[2] - A[2]) * m)
    ];
  }

  function draw(t) {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    // faint drifting hearts
    var i, f;
    for (i = 0; i < floaters.length; i++) {
      f = floaters[i];
      var yy = reduce ? f.y : ((f.y - t * f.v) % 1 + 1) % 1;
      var xx = f.x + (reduce ? 0 : Math.sin(t * 0.5 + f.d) * 0.02);
      ctx.save();
      ctx.translate(xx * W, yy * H);
      ctx.globalAlpha = f.a;
      ctx.fillStyle = 'rgb(255,150,175)';
      heartPath(f.s);
      ctx.fill();
      ctx.restore();
    }

    // heartbeat scale
    var s = 1;
    if (!reduce) {
      var ph = (t % 1.4) / 1.4;
      var b = Math.exp(-Math.pow((ph - 0.1) / 0.06, 2)) * 0.6 +
              Math.exp(-Math.pow((ph - 0.3) / 0.08, 2)) * 0.4;
      s = 1 + 0.035 * b;
    }

    ctx.save();
    ctx.translate(W / 2, H / 2);
    ctx.scale(k * s, k * s);

    // faint body fill so the shape reads even between words
    ctx.globalAlpha = 1;
    ctx.fillStyle = 'rgba(255,93,126,0.07)';
    ctx.fill(shapePath);

    ctx.save();
    ctx.clip(shapePath);
    ctx.font = fontCss;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    for (var j = 0; j < words.length; j++) {
      var w = words[j];
      var m = reduce ? 0.35 : 0.5 + 0.5 * Math.sin(t * 1.1 - w.ph * 2.2);
      var c = mix(m);
      ctx.globalAlpha = 0.72 + 0.28 * m;
      ctx.fillStyle = 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
      ctx.fillText(WORD, w.x, w.y);
    }
    ctx.restore();

    // thin outline
    ctx.globalAlpha = 0.5;
    ctx.lineWidth = 2;
    ctx.strokeStyle = 'rgb(255,93,126)';
    ctx.stroke(shapePath);
    ctx.restore();

    // tap bursts
    ctx.globalAlpha = 1;
    for (var n = bursts.length - 1; n >= 0; n--) {
      var p = bursts[n];
      p.life -= 0.012;
      if (p.life <= 0) { bursts.splice(n, 1); continue; }
      p.x += p.vx;
      p.y += p.vy;
      p.vy -= 0.01;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.globalAlpha = Math.min(1, p.life) * 0.9;
      ctx.fillStyle = 'rgb(255,201,214)';
      heartPath(p.s);
      ctx.fill();
      ctx.restore();
    }
    ctx.globalAlpha = 1;
  }

  function frame(ts) {
    draw(ts / 1000);
    requestAnimationFrame(frame);
  }

  cv.addEventListener('pointerdown', function (e) {
    e.preventDefault();
    var r = cv.getBoundingClientRect();
    var x = e.clientX - r.left, y = e.clientY - r.top;
    for (var i = 0; i < 9; i++) {
      var a = -Math.PI / 2 + (Math.random() - 0.5) * 2.2;
      var sp = 0.8 + Math.random() * 1.6;
      bursts.push({
        x: x, y: y,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        s: 4 + Math.random() * 6, life: 1 + Math.random() * 0.6
      });
    }
    if (reduce) draw(0);
  });

  var rt;
  window.addEventListener('resize', function () {
    if (!started) return;
    clearTimeout(rt);
    rt = setTimeout(layout, 60);
  });

  function start() {
    if (started) return;
    started = true;
    buildShape();
    buildWords();
    layout();
    if (!reduce) requestAnimationFrame(frame);
  }

  if (document.fonts && document.fonts.load) {
    document.fonts.load('600 20px Mali', WORD).then(start, start);
    setTimeout(start, 2500);
  } else {
    start();
  }
})();
</script>
